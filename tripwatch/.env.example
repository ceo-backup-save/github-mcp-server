# TripWatch AI — copie para .env e ajuste. NUNCA comite o .env real.
# O app lê este arquivo automaticamente (stdlib, sem python-dotenv).

# Porta e banco
PORT=8787
TRIPWATCH_HOST=0.0.0.0
TRIPWATCH_DB=./data/tripwatch.db

# Provedor de preços: auto | demo | serpapi
TRIPWATCH_PROVIDER=auto
SERPAPI_KEY=
SERPAPI_CURRENCY=BRL
SERPAPI_HL=pt-br
SERPAPI_GL=br

# LLM opcional (briefing e chat)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Agendador
# TRIPWATCH_DISABLE_SCHEDULER=1
